.cache/ms-playwright/
playwright-report/
test-results/
*.trace.zip

# --- Audit run artifacts (regenerate on demand; keep the repo clean) ---
# The checked-in reference sample lives at
# skills/audit-orchestrator/references/sample-report.json — do NOT ignore that one.
/report.html
/report.json
/*.report.html
/*.report.json
/tmp_artifact*.json

# --- Environment / secrets ---
.env
.env.*
*.local

