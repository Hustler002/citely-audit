{
  "$schema": "./scoring-config.schema-note",
  "_note": "Single source of truth for severity thresholds and score weights. The orchestrator passes this file to each sub-skill via --config; each sub-skill also embeds equivalent safe defaults so it remains independently runnable. Values below are PLACEHOLDER DEFAULTS to be tuned against the test fixtures (plan §10).",

  "score_weights": {
    "_note": "discoverability_score = clamp(100 - sum(penalty per finding), 0, 100)",
    "critical": 20,
    "high": 10,
    "medium": 4
  },

  "categories": [
    "crawl-ingestion",
    "quotability",
    "information-density",
    "entity-corroboration",
    "engagement-orientation"
  ],

  "crawl_render_extraction": {
    "spa_shell_max_visible_chars": 500,
    "spa_script_to_text_ratio": 3.0,
    "spa_mount_node_selectors": ["#root", "#app", "#__next", "[data-reactroot]"],
    "spa_framework_markers": ["__NEXT_DATA__", "window.__NUXT__", "ng-version", "data-server-rendered"],
    "render_diff_significant_text_delta_chars": 400,
    "fact_extraction_min_text_to_node_ratio": 1.0,
    "fact_extraction_flag_missing_alt": true
  },

  "quotability_density": {
    "min_quotable_sentences": 3,
    "vague_marketing_tokens": ["best-in-class", "world-class", "cutting-edge", "synergy", "innovative", "leading", "seamless", "revolutionary"],
    "min_factual_to_filler_ratio": 0.25,
    "long_page_word_threshold": 2000
  },

  "entity_corroboration": {
    "required_jsonld_types": ["Organization", "Person", "LocalBusiness", "WebSite"],
    "expect_sameas": true,
    "wikidata_lookup_enabled_by_default": false
  },

  "engagement_orientation": {
    "first_viewport_px": 800,
    "require_h1": true,
    "value_prop_signal_verbs": ["build", "create", "manage", "automate", "help", "audit", "analyze", "sell", "track"],
    "require_cta": true,
    "min_body_font_px": 14
  }
}
